#matrix calculator
import numpy as np
def sub(x, y):
    return x - y

def add(x, y):
    return x + y

def div(x, y):
    return x / y
    
def mul(x, y):
    return x * y

x = np.array([[1, 2, 3], [4, 5, 6]])
y = np.array([[7, 8, 9], [10, 11, 12]])

print('1.ADDITION')
print('2.SUBTRACTION')
print('3.DIVISION')
print('4.MULTIPLICATION')

c=int(input("Enter your choice:"))
if c==1:
    print(add(x, y))
elif c==2:
    print(sub(x, y))
elif c==3:
    print(div(x, y))
elif c==4:
    print(mul(x, y))
else:
    print("Invalid choice")

