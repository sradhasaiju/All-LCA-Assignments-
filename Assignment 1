#list,tuple and dictionary operations

#creating a list
l=['Amit','Rohan','Laya','Riya','Kevin']

#creating a tuple
t=('Amit','Rohan','Laya','Riya','Kevin')

#creating a dictionary with students id and name
d={101:'Amit',102:'Rohan',103:'Laya',104:'Riya',105:'Kevin'}

#displaying the original data
print('Original List:',l)
print('\nOriginal Tuple:',t)
print('\nOriginal Dictionary:',d)

#output:
Original List: ['Amit', 'Rohan', 'Laya', 'Riya', 'Kevin']

Original Tuple: ('Amit', 'Rohan', 'Laya', 'Riya', 'Kevin')

Original Dictionary: {101: 'Amit', 102: 'Rohan', 103: 'Laya', 104: 'Riya', 105: 'Kevin'}

#adding a new entry to the dictionary
d[106]='Jaya'
print('After adding :',d) 

#output:
After adding : {101: 'Amit', 102: 'Rohan', 103: 'Laya', 104: 'Riya', 105: 'Kevin', 106: 'Jaya'}

#updating an existing entry
d[102]='Siya'
print('After updating :',d)

#output:
After updating : {101: 'Amit', 102: 'Siya', 103: 'Laya', 104: 'Riya', 105: 'Kevin', 106: 'Jaya'}

#deleting an entry from the dictionary
del d[104]
print('After deleting :',d)

#output:
After deleting : {101: 'Amit', 102: 'Siya', 103: 'Laya', 105: 'Kevin', 106: 'Jaya'}
